{
  "name": "mot-literature-mcp",
  "version": "0.1.1",
  "description": "Local stdio MCP server for deterministic PDF literature access: page text, page images, references, full-text search. No LLM, no network.",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "mot-literature-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "python"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
