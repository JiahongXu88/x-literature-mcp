{
  "mcpServers": {
    "x-literature": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/absolute/path/to/x-literature-mcp/dist/server.js"
      ],
      "env": {
        "X_LIT_PDF_ROOT": "/absolute/path/to/your/pdf-folder",
        "X_LIT_PYTHON": "/absolute/path/to/x-literature-mcp/.venv/bin/python",
        "X_LIT_CACHE_DIR": "/absolute/path/to/x-literature-mcp-cache"
      }
    }
  }
}
